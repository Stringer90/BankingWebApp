@{
    ViewData["Title"] = "Edit Profile";
}

<form id="editProfileForm">
    <input type="text" id="new-username" name="username" placeholder="Enter new username" required>
    <input type="password" id="new-password" name="password" placeholder="Enter new password">
    <input type="email" id="new-email" name="email" placeholder="Enter new email" required>
    <input type="text" id="new-address" name="address" placeholder="Enter new address" required>
    <input type="text" id="new-phone" name="phone" placeholder="Enter new phone number" required>
    <button type="button" id="save-details">Update Profile</button>
</form>