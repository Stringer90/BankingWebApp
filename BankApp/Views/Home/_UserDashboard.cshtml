<div id="user-dashboard">
    <link rel="stylesheet" href="~/css/userdashboard.css" asp-append-version="true" />
    <h1>Welcome, <span id="user-name">Name</span> <button id="edit-profile" class="btn btn-sm btn-primary">Edit Profile</button></h1>

    <div id="accounts-list">
        <!-- Accounts will be dynamically inserted here -->
    </div>


    <button id="add-account" class="btn btn-success mt-3">Add account</button>
    <button id="deposit" class="btn btn-success">Deposit</button>
    <button id="withdraw" class="btn btn-success">Withdraw</button>
    <button id="refresh-accounts" class="btn btn-primary mt-3">Refresh Accounts</button>
    <button id="logout" class="btn btn-danger mt-3">Logout</button>
</div>