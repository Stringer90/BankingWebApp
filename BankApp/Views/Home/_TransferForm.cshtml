<div id="transfer-form">
    <button id="back-to-dashboard" class="btn btn-success">Back</button>

    <select id="transferring-from" class="form-control mt-3">
        <option value="">Transferring from</option>
    </select>

    <input type="text" id="transferring-to" class="form-control mt-3" placeholder="Transferring to (Account number)">
    <input type="number" id="transfer-amount" class="form-control mt-3" placeholder="Amount $$">
    <input type="text" id="transfer-description" class="form-control mt-3" placeholder="Description">

    <button id="submit-transfer" class="btn btn-success mt-3">Transfer</button>
</div>  