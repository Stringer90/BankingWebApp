    <select id="withdraw-from" class="form-control mt-3">
        <option value="">Withdrawing from</option>
    </select>

    <input type="number" id="withdraw-amount" class="form-control mt-3" placeholder="Amount $$">

    <button id="submit-withdrawal" class="btn btn-success mt-3">Withdraw</button>
</div>