        <Button x:Name="LoginButton" Content="Log in" HorizontalAlignment="Center" Margin="0,238,0,0" VerticalAlignment="Top" Height="38" Width="120" Click="Button_Click"/>
        <TextBlock x:Name="UserName" HorizontalAlignment="Left" Margin="300,124,0,0" TextWrapping="Wrap" Text="Username" VerticalAlignment="Top" Height="21" Width="88"/>
        <TextBlock x:Name="StatusText" HorizontalAlignment="Left" Margin="367,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <Button x:Name="TestBtn" Content="test" HorizontalAlignment="Left" Margin="648,257,0,0" VerticalAlignment="Top" Height="39" Width="65" Click="TestBtn_Click"/>

    </Grid>
</Window>
