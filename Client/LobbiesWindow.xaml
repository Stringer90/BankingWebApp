<Window x:Class="Client.LobbiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="LobbiesWindow" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="LobbyList" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="656,54,0,137"/>
        <TextBox HorizontalAlignment="Left" Margin="656,22,0,0" TextWrapping="Wrap" Text="Available Lobbies" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="CreateLobbyBtn" Content="Create Lobby" HorizontalAlignment="Left" Margin="76,251,0,0" VerticalAlignment="Top" Height="46" Width="106" Click="CreateLobbyBtn_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="59,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="16" Width="140"><Run Language="en-au" Text="Create a new lobby here"/></TextBlock>
        <TextBox x:Name="LobbyName" HorizontalAlignment="Left" Margin="59,175,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="140" Height="29"/>
        <TextBlock HorizontalAlignment="Left" Margin="59,154,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="en-au" Text="Enter the name you would like"/></TextBlock>
        <Button x:Name="JoinLobbyBtn" Content="Join Lobby" HorizontalAlignment="Left" Margin="670,328,0,0" VerticalAlignment="Top" Height="46" Width="106" Click="JoinLobbyBtn_Click"/>
        <TextBlock x:Name="LobbyStatusText" HorizontalAlignment="Left" Margin="104,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>

    </Grid>
</Window>
